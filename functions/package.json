{
  "name": "functions",
  "scripts": {
    "lint": "eslint",
    "build": "tsc",
    "build:watch": "tsc --watch",
    "serve": "npm run build && firebase emulators:start --only functions",
    "shell": "npm run build && firebase functions:shell",
    "start": "npm run shell",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log",
    "test": "npm run build && node --test test/telegram_notification.test.js test/payment_reconciliation.test.js test/staff_auth.test.js test/daily_stats.test.js",
    "test:rules": "npx --yes firebase-tools emulators:exec --only firestore \"node --test test/firestore-rules.test.js\"",
    "check:rules-drift": "node scripts/check-firestore-rules-drift.js",
    "test:derived": "npm run build && npx --yes firebase-tools emulators:exec --project demo-lunaexpress --only functions,firestore \"node --test test/derived_views.emulator.test.js\""
  },
  "engines": {
    "node": "22"
  },
  "main": "lib/index.js",
  "dependencies": {
    "firebase-admin": "^13.1.0",
    "firebase-functions": "^6.0.1",
    "node-telegram-bot-api": "^0.66.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@types/node-telegram-bot-api": "^0.64.14",
    "eslint": "^8.57.0",
    "eslint-config-google": "^0.14.0",
    "eslint-plugin-import": "^2.29.1",
    "firebase": "^12.19.0",
    "typescript": "^5.4.5"
  },
  "private": true,
  "overrides": {
    "form-data": "^2.5.6",
    "@grpc/grpc-js": "^1.14.0"
  }
}
