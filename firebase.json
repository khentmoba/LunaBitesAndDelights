{
  "hosting": [
    {
      "target": "app-site",
      "public": "build/web",
      "ignore": [
        "firebase.json",
        "**/.*",
        "**/node_modules/**"
      ],
    "headers": [
      {
        "source": "**",
        "headers": [
          {
            "key": "Strict-Transport-Security",
            "value": "max-age=31536000; includeSubDomains"
          },
          {
            "key": "X-Content-Type-Options",
            "value": "nosniff"
          },
          {
            "key": "X-Frame-Options",
            "value": "DENY"
          },
          {
            "key": "Referrer-Policy",
            "value": "strict-origin-when-cross-origin"
          },
          {
            "key": "Permissions-Policy",
            "value": "camera=(), microphone=(), geolocation=(self)"
          },
          {
            "key": "Cross-Origin-Opener-Policy",
            "value": "same-origin-allow-popups"
          }
        ]
      },
      {
        "source": "**/*.@(woff2|webp|avif|png|jpg|jpeg|svg|ico)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=86400, stale-while-revalidate=604800"
          }
        ]
      },
      {
        "source": "{/,/index.html,/menu/**,/payment/**,/kiosk/,/kiosk/index.html,/kiosk/flutter_bootstrap.js,/kiosk/main.dart.js,/kiosk/sw.js,/kiosk/version.json,/kiosk/assets/*.json,/kiosk/canvaskit/**}",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      }
    ],
    "redirects": [
      {
        "source": "/kiosk",
        "destination": "/kiosk/",
        "type": 301
      }
    ],
    "rewrites": [
      {
        "source": "/menu{,/**}",
        "destination": "/menu/index.html"
      },
      {
        "source": "/payment/success{,/**}",
        "destination": "/payment/success/index.html"
      },
      {
        "source": "/payment/cancel{,/**}",
        "destination": "/payment/cancel/index.html"
      },
      {
        "source": "/kiosk/**",
        "destination": "/kiosk/index.html"
      }
    ]
  },
    {
      "site": "lunaexpress",
      "public": "legacy-redirect",
      "redirects": [
        {
          "source": "/kiosk{,/**}",
          "destination": "https://lunabitesanddelights.web.app/kiosk/",
          "type": 301
        },
        {
          "source": "/**",
          "destination": "https://lunabitesanddelights.web.app/",
          "type": 301
        }
      ]
    }
  ],
  "firestore": {
    "database": "(default)",
    "rules": "firestore.rules"
  },
  "storage": {
    "rules": "storage.rules"
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log"
      ]
    }
  ]
}
