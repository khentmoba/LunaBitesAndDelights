---
import Kiosk from '../../layouts/Kiosk.astro';
import { glyph } from '../../kiosk/icons';
---
<Kiosk title="Your order · Luna Bites & Delights">
<div class="page">
  <header class="appbar">
    <button type="button" class="appbar__lead" data-back aria-label="Back">
      <span class="icon" aria-hidden="true">{glyph('arrow_back')}</span>
    </button>
    <h1 class="appbar__title">Your order</h1>
    <div class="appbar__actions">
      <button type="button" class="textbtn cancel" data-cancel hidden>Cancel order</button>
    </div>
  </header>

  <main class="empty" data-empty hidden>
    <span class="icon empty__icon" aria-hidden="true">{glyph('shopping_cart_outlined')}</span>
    <h2 class="empty__title">Your order slip is empty</h2>
    <button type="button" class="btn-filled" data-back>Browse the menu</button>
  </main>

  <main class="body" data-filled hidden>
    <div class="scroll">
      <section class="slip" aria-labelledby="slip-title">
        <div class="slip__head">
          <h2 class="slip__title" id="slip-title">Order slip</h2>
          <span class="slip__count" data-count></span>
        </div>
        <div class="slip__double" aria-hidden="true"></div>
        <div class="slip__cols" aria-hidden="true"><span>ITEM</span><span>AMOUNT</span></div>
        <div class="slip__rule" aria-hidden="true"></div>
        <ul class="slip__rows" data-rows></ul>
        <p class="slip__hint">Swipe a line left to remove it.</p>
      </section>
    </div>
    <footer class="bar">
      <div class="bar__in">
        <div class="bar__total">
          <span class="bar__label">TOTAL</span>
          <span class="bar__price" data-total></span>
        </div>
        <div class="bar__actions">
          <button type="button" class="outlined" data-back><span class="ellipsis"><span class="m">Add more</span><span class="d">Add more food</span></span></button>
          <a class="checkout" href="/kiosk/checkout">Checkout</a>
        </div>
      </div>
    </footer>
  </main>
</div>
</Kiosk>

<style is:global>
body { overflow: hidden; }
.page { display: flex; flex-direction: column; height: 100dvh; background: var(--ground); }
.cancel { color: var(--error); font-size: 13px; font-weight: 800; letter-spacing: .6px; line-height: 1.2; }

/* Empty slip */
.empty { flex: 1; display: flex; flex-direction: column; align-items: center; justify-content: center; padding: 24px 32px; overflow-y: auto; text-align: center; }
.empty__icon { font-size: 96px; color: rgb(236 28 114 / .35); }
.empty__title { margin: 16px 0 28px; font-size: 24px; font-weight: 800; letter-spacing: -.4px; line-height: 1.12; }

/* Filled slip, lib/screens/cart_page.dart _buildSlip */
.body { flex: 1; display: flex; flex-direction: column; min-height: 0; }
.scroll { flex: 1; overflow-y: auto; padding: 32px 32px 24px; }
.slip { max-width: 760px; margin: 0 auto; padding: 26px 28px 14px; background: var(--paper); border-radius: var(--radius-sm); box-shadow: var(--shadow-md); }
.slip__head { display: flex; align-items: flex-end; }
.slip__title { flex: 1; margin: 0; color: var(--pink); font-size: 34px; font-weight: 800; letter-spacing: -.6px; line-height: 1.08; }
.slip__count { font-family: var(--hand); font-size: 26px; font-weight: 600; line-height: 1.1; letter-spacing: .25px; }
.slip__double { height: 4px; margin-top: 12px; border-top: 1px solid var(--pink); border-bottom: 1px solid var(--pink); }
.slip__cols { display: flex; justify-content: space-between; padding: 14px 0 6px; font-size: 11.5px; font-weight: 700; letter-spacing: 1.5px; line-height: 1.2; color: var(--pink-ink); }
.slip__rule { height: 2px; background: var(--pink); }
.slip__rows { margin: 0; padding: 0; list-style: none; }
.slip__hint { display: none; margin: 0; padding: 10px 0 6px; font-size: 12px; font-weight: 500; line-height: 1.4; color: var(--ink-muted); }

.row { position: relative; overflow: hidden; }
.row__bg { position: absolute; inset: 0; display: flex; align-items: center; justify-content: flex-end; padding-right: 16px; background: var(--error); color: #fff; }
.row__bg .icon { font-size: 26px; }
.row__fg { position: relative; display: flex; align-items: center; padding: 12px 0; background: var(--paper); border-bottom: 1px solid var(--rule); touch-action: pan-y; }
.row__fg.settle { transition: transform .2s ease-out; }
.row__thumb { padding: 3px; background: #fff; box-shadow: var(--shadow-sm); flex: none; }
.row__thumb img { width: 72px; height: 72px; object-fit: cover; }
.row__text { flex: 1; min-width: 0; margin-left: 18px; }
.row__name { margin: 0; font-size: 17px; font-weight: 600; line-height: 1.3; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
.row__variant { margin: 0; font-size: 13px; font-weight: 500; line-height: 1.4; color: var(--ink-muted); display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
.row__price { margin-left: 10px; font-size: 22px; font-weight: 800; letter-spacing: -.2px; line-height: 1.2; font-variant-numeric: tabular-nums; }

.stepper { display: inline-flex; align-items: center; margin-top: 6px; background: var(--blush-paper); border: 1.5px solid var(--rule); border-radius: var(--radius); }
.stepper button { display: grid; place-items: center; width: 44px; height: 44px; border-radius: 50%; color: var(--pink-ink); }
.stepper button:hover { background: rgb(42 15 30 / .08); }
.stepper .icon { font-size: 20px; }
.stepper__qty { min-width: 28px; padding: 0 4px; font-family: var(--hand); font-size: 22px; font-weight: 600; line-height: 1.1; text-align: center; }

/* Total bar */
.bar { background: var(--paper); border-top: 2px solid var(--pink); box-shadow: var(--shadow-lg); padding-bottom: env(safe-area-inset-bottom); }
.bar__in { max-width: 760px; margin: 0 auto; padding: 24px 32px; container-type: inline-size; }
.bar__total { display: flex; align-items: center; justify-content: space-between; }
.bar__label { font-size: 16px; font-weight: 700; letter-spacing: 1.5px; line-height: 1.2; color: var(--ink-soft); }
.bar__price { font-size: 40px; font-weight: 800; letter-spacing: -.9px; line-height: 1.02; font-variant-numeric: tabular-nums; }
.bar__actions { display: flex; gap: 12px; margin-top: 20px; }
.outlined, .checkout { display: flex; align-items: center; justify-content: center; min-width: 0; min-height: 42px; padding: 0 24px; border-radius: var(--radius); }
.outlined { flex: 0 0 calc((100% - 12px) / 3); border: 2px solid var(--pink-ink); color: var(--pink-ink); font-size: 15px; font-weight: 700; line-height: 1.2; }
.outlined:hover { background: rgb(179 14 82 / .08); }
.ellipsis { min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.outlined .m { display: none; }
.checkout { flex: 1; background: var(--plate); color: var(--on-plate); font-size: 16px; font-weight: 800; line-height: 1.2; }
.checkout:hover { background: color-mix(in srgb, var(--plate), white 8%); }
@container (max-width: 309.98px) {
  .bar__actions { flex-direction: column-reverse; gap: 8px; }
  .outlined { flex-basis: auto; }
}

@media (max-width: 699px) {
  .cancel { font-size: 12px; }
  .empty__icon { font-size: 60px; }
  .empty__title { font-size: 20px; margin-bottom: 20px; }
  .scroll { padding: 16px 14px 24px; }
  .slip { padding: 18px 16px 8px; }
  .slip__title { font-size: 28px; }
  .slip__count { font-size: 22px; }
  .slip__hint { display: block; }
  .row__thumb img { width: 52px; height: 52px; }
  .row__text { margin-left: 12px; }
  .row__name { font-size: 15px; }
  .row__price { font-size: 19px; }
  .bar__in { padding: 14px 16px; }
  .bar__label { font-size: 13px; }
  .bar__price { font-size: 28px; }
  .bar__actions { margin-top: 12px; }
  .outlined .m { display: inline; }
  .outlined .d { display: none; }
}
</style>

<script>
import { cart, peso, type CartItem } from '../../kiosk/cart';
import { $, esc, itemThumb } from '../../kiosk/dom';
import { glyph } from '../../kiosk/icons';
import { popTo, resetKiosk, watchInactivity } from '../../kiosk/inactivity';

function row(item: CartItem): string {
  const name = esc(item.name);
  return `<li class="row" data-id="${esc(item.id)}">
  <div class="row__bg" aria-hidden="true"><span class="icon">${glyph('delete_outline_rounded')}</span></div>
  <div class="row__fg">
    <div class="row__thumb"><img src="${itemThumb(item.imageUrl)}" alt="" onerror="this.onerror=null;this.src='/kiosk/images/luna_logo.webp'"></div>
    <div class="row__text">
      <p class="row__name">${name}</p>
      ${item.variant ? `<p class="row__variant">${esc(item.variant)}</p>` : ''}
      <div class="stepper">
        <button type="button" data-step="-1" aria-label="One less ${name}"><span class="icon" aria-hidden="true">${glyph('remove_rounded')}</span></button>
        <span class="stepper__qty">${item.quantity}</span>
        <button type="button" data-step="1" aria-label="One more ${name}"><span class="icon" aria-hidden="true">${glyph('add_rounded')}</span></button>
      </div>
    </div>
    <span class="row__price">${peso(item.price * item.quantity)}</span>
  </div>
</li>`;
}

function render() {
  const items = cart.items();
  const empty = items.length === 0;
  $<HTMLElement>('[data-empty]').hidden = !empty;
  $<HTMLElement>('[data-filled]').hidden = empty;
  $<HTMLElement>('[data-cancel]').hidden = empty;
  if (empty) return;
  const n = cart.totalCount();
  $('[data-count]').textContent = `${n} ${n === 1 ? 'item' : 'items'}`;
  $('[data-total]').textContent = peso(cart.totalPrice());
  $('[data-rows]').innerHTML = items.map(row).join('');
}

$('[data-rows]').addEventListener('click', (e) => {
  const step = (e.target as Element).closest<HTMLElement>('[data-step]');
  const id = step?.closest<HTMLElement>('.row')?.dataset.id;
  if (!step || !id) return;
  if (step.dataset.step === '1') cart.increment(id);
  else cart.decrement(id);
});

// Dismissible, end to start: drag a line left past 40% of its width to remove it.
let drag: { fg: HTMLElement; id: string; x: number; dx: number; pointer: number } | null = null;
$<HTMLElement>('[data-rows]').addEventListener('pointerdown', (e) => {
  const fg = (e.target as Element).closest<HTMLElement>('.row__fg');
  if (!fg || (e.target as Element).closest('button')) return;
  drag = { fg, id: fg.closest<HTMLElement>('.row')!.dataset.id!, x: e.clientX, dx: 0, pointer: e.pointerId };
  fg.classList.remove('settle');
});
window.addEventListener('pointermove', (e) => {
  if (!drag || e.pointerId !== drag.pointer) return;
  drag.dx = Math.min(0, e.clientX - drag.x);
  if (drag.dx < -6) drag.fg.setPointerCapture?.(e.pointerId);
  drag.fg.style.transform = `translateX(${drag.dx}px)`;
});
const release = () => {
  if (!drag) return;
  const { fg, id, dx } = drag;
  drag = null;
  fg.classList.add('settle');
  if (dx < -fg.offsetWidth * 0.4) {
    let removed = false;
    const finish = () => {
      if (removed) return;
      removed = true;
      cart.remove(id);
    };
    fg.style.transform = 'translateX(-100%)';
    fg.addEventListener('transitionend', finish, { once: true });
    window.setTimeout(finish, 250);
  } else fg.style.transform = '';
};
window.addEventListener('pointerup', release);
window.addEventListener('pointercancel', release);

for (const b of document.querySelectorAll('[data-back]')) b.addEventListener('click', () => popTo('/kiosk/menu'));
$('[data-cancel]').addEventListener('click', resetKiosk);

cart.subscribe(render);
watchInactivity();
</script>
