---
import '../kiosk/tokens.css';

interface Props {
  title?: string;
}
const { title = 'Order · Luna Bites & Delights' } = Astro.props;
---
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
<meta name="description" content="Luna Bites & Delights — Fast food ordering app">
<meta name="robots" content="noindex, follow">
<meta name="theme-color" content="#EC1C72">
<meta property="og:type" content="website">
<meta property="og:title" content="Order · Luna Bites &amp; Delights">
<meta property="og:description" content="Order shawarma, burgers, fries and coolers from Luna Bites &amp; Delights in Magallanes, Agusan del Norte.">
<meta property="og:image" content="https://lunabitesanddelights.web.app/images/og-cover.jpg">
<link rel="icon" type="image/png" href="/img/favicon-32.png">
<link rel="manifest" href="/kiosk/manifest.json">
<link rel="apple-touch-icon" href="/kiosk/icons/Icon-192.png">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-title" content="Luna Bites">
<link rel="preload" href="/kiosk/fonts/Bricolage-700.ttf" as="font" type="font/ttf" crossorigin>
<link rel="preload" href="/kiosk/fonts/Bricolage-800.ttf" as="font" type="font/ttf" crossorigin>
<link rel="preload" href="/kiosk/fonts/material-icons.woff2" as="font" type="font/woff2" crossorigin>
<title>{title}</title>
</head>
<body>
<slot />
</body>
</html>
